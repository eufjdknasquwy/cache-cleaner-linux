{
  "categories":
  [
    {
      "category" : "Safe",
      "danger_level" : "Safe",
      "entries" :
      [
        // AUR helpers
        { "name": "yay", "desc": "AUR helper", "path": "~/.cache/yay", "type": "path" },
        { "name": "paru", "desc": "AUR helper", "path": "~/.cache/paru", "type": "path" },

        // programming languages package managers
        { "name": "pip", "desc": "Python package manager", "path": "~/.cache/pip", "type": "command", "command": "pip cache purge" },
        { "name": "pipx", "desc": "Python app manager", "path": "~/.cache/pipx", "type": "command", "command": "pipx cache purge" },
        { "name": "go", "desc": "Go build cache", "path": "~/.cache/go-build", "type": "command", "command": "go clean -cache -fuzzcache -modcache" },
        { "name": "nuget", "desc": ".NET package manager", "path": "~/.nuget/packages", "type": "command", "command": "dotnet nuget locals all --clear" },
        { "name": "npm", "desc": "Node.js package manager", "path": "~/.npm/_cacache", "type": "command", "command": "npm cache clean --force" },
        { "name": "cargo", "desc": "Rust package cache\nRequires cargo-cache package\n(cargo install cargo-cache)", "path": "~/.cargo/registry/cache", "type": "command", "command": "cargo cache -a" },
        { "name": "yarn", "desc": "Node.js package manager", "path": "~/.cache/yarn", "type": "command", "command": "yarn cache clean" },
        { "name": "maven", "desc": "Java build tool", "path": "~/.m2/repository", "type": "command", "command": "mvn dependency:purge-local-repository" },
        { "name": "composer-cache", "desc": "PHP package manager", "path": "~/.cache/composer", "type": "command", "command": "composer clear-cache" },
        { "name": "composer-home", "desc": "PHP package manager", "path": "~/.composer/cache", "type": "command", "command": "composer clear-cache" },
        { "name": "ruby", "desc": "RubyGems package manager", "path": "~/.gem/ruby", "type": "command", "command": "gem cleanup" },
        { "name": "bundler", "desc": "Ruby dependency manager", "path": "~/.bundle/cache", "type": "command", "command": "bundle clean --force" },
        { "name": "deno", "desc": "Deno runtime cache", "path": "~/.cache/deno", "type": "path" },

        // (with path type)
        { "name": "cargo-registry", "desc": "Rust package cache", "path": "~/.cargo/registry/cache", "type": "path" },
        { "name": "gradle", "desc": "Java build tool", "path": "~/.gradle/caches", "type": "path"},
        { "name": "sbt", "desc": "Scala build tool", "path": "~/.sbt", "type": "path" },
