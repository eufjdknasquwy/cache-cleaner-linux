        { "name": "nix", "type": "command", "command": "nix-collect-garbage -d", "root": true },

        { "name": "pkg", "type": "command", "command": "pkg clean -a", "root": true },
        { "name": "pkgin", "type": "command", "command": "pkgin clean", "root": true },
        { "name": "pkg_add", "type": "command", "command": "pkg_delete -a", "root": true },

        { "name": "brew", "type": "command", "command": "brew cleanup -s", "root": true },

        { "name": "flatpak", "type": "command", "command": "flatpak uninstall --unused", "root": false },
        { "name": "snap", "type": "command", "command": "rm -rf /var/lib/snapd/cache/*", "root": true },

        { "name": "journalctl", "type": "command", "command": "journalctl --vacuum-time=2weeks", "root": true },

        { "name": "Docker (Rootful)", "path": "docker", "desc": "Needs root", "type": "command", "command": "docker system prune -af", "root": true },
