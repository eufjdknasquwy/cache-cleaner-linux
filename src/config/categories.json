    {
      "category" : "System",
      "danger_level" : "System",
      "entries" :
      [
        // system package managers
        // (main)
        { "name": "pacman", "desc": "Arch Linux package manager", "type": "command", "command": "pacman -Sc --noconfirm", "root": true },
        { "name": "dnf", "desc": "Fedora/RHEL package manager", "type": "command", "command": "dnf clean all", "root": true },
        { "name": "apt", "desc": "Debian/Ubuntu package manager", "type": "command", "command": "sh -c 'apt clean && apt autoclean'", "root": true },

        // (rare)
        { "name": "zypper", "desc": "openSUSE package manager", "type": "command", "command": "zypper clean --all", "root": true },
        { "name": "apk", "desc": "Alpine Linux package manager", "type": "command", "command": "apk cache clean", "root": true },
        { "name": "xbps", "desc": "Void Linux package manager", "type": "command", "command": "xbps-remove -O", "root": true },
        { "name": "portage", "desc": "Gentoo package manager", "type": "command", "command": "sh -c 'eclean-dist -d && eclean-pkg -d'", "root": true },
        { "name": "nix", "desc": "Nix package manager", "type": "command", "command": "nix-collect-garbage -d", "root": true },

        // BSD systems (pkg)
        { "name": "pkg", "desc": "FreeBSD package manager", "type": "command", "command": "pkg clean -a", "root": true },
        { "name": "pkgin", "desc": "NetBSD package manager", "type": "command", "command": "pkgin clean", "root": true },
        { "name": "pkg_add", "desc": "OpenBSD package manager", "type": "command", "command": "pkg_delete -a", "root": true },

        // other
        { "name": "flatpak", "desc": "Unused flatpak packages", "type": "command", "command": "flatpak uninstall --unused -y", "root": false },
        { "name": "snap", "desc": "Canonical Snap packages", "type": "command", "command": "rm -rf /var/lib/snapd/cache/*", "root": true },

        { "name": "journalctl", "desc": "Systemd journal logs", "type": "command", "command": "journalctl --vacuum-time=2weeks", "root": true },

        // containers
        { "name": "docker", "desc": "Docker cache (root)", "type": "command", "command": "docker system prune -af", "root": true },
        { "name": "podman", "desc": "Podman cache (root)", "type": "command", "command": "podman system prune -af", "root": true }
