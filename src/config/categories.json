        { "name": "zypper", "type": "command", "command": "zypper clean --all", "root": true },
        { "name": "apk", "type": "command", "command": "apk cache clean", "root": true },
        { "name": "xbps", "type": "command", "command": "xbps-remove -O", "root": true },
