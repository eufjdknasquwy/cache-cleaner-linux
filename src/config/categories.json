// DO NOT TOUCH THIS FILE
// THIS FILE IS USED FOR SCANNING CACHE DIRECTORIES
// IF YOU WANT TO ADD YOUR OWN CACHE DIRECTORY, YOU SHOULD
// ADD IT TO user_directories.json IN ~/.config/cache-cleaner
{
  "categories":
  [
    {
      "category" : "Safe",
      "danger_level" : "Safe",
      "paths" :
      [
        "~/.cache/yay",
        "~/.cache/paru",

        "~/.cache/pip",
        "~/.cache/go-build",
        "~/.nuget/packages",
        "~/.npm/_cacache",
        "~/.cache/tldr"
      ]
    },
    {
      "category" : "Warning",
      "danger_level" : "Warning",
      "paths" :
      [
        "~/.cache/trizen",
        "~/.cache/pikaur",
        "~/.cache/gstreamer-1.0",
        "~/.cache/thumbnails",
        "~/.cache/fontconfig",
        "~/.cache/mpv",
        "~/.cache/vlc",
        "~/.cache/nvidia",
        "~/.cache/mesa_shader_cache"
      ]
    },
    {
      "category" : "Unknown",
      "danger_level" : "Unknown",
      "paths" :
      [
      ]
    },
    {
      "category" : "System",
      "danger_level" : "System",
      "paths" :
      [
        "pacman",
        "apt",
        "dnf",

        "flatpak",
        "snap",

        "journalctl (systemd logs)"
      ]
    }
  ]
}
