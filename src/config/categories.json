        { "name": "zig", "desc": "Zig compiler cache", "path": "~/.cache/zig", "type": "path" },
        { "name": "swift-pm", "desc": "Swift package manager", "path": "~/.cache/org.swift.swiftpm", "type": "path" },
        { "name": "swift-cache", "desc": "Swift build cache", "path": "~/.swiftpm/cache", "type": "path" },

        // other
        { "name": "Thumbnails", "desc": "Image preview cache", "path": "~/.cache/thumbnails", "type": "path" },
        { "name": "Ccache", "desc": "Compiler cache", "path": "~/.cache/ccache", "type": "path" },
        { "name": "Flatpak", "desc": "Flatpak cache", "path": "~/.cache/flatpak", "type": "path" }
      ]
    },
